datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// Enums
// ------------------------------------------------------
enum ContactType {
  CUSTOMER
  VENDOR
}

enum ProductType {
  GOODS
  SERVICE
  COMBO
}

enum AccountType {
  ASSET
  LIABILITY
  BANK
  CASH
  CAPITAL
  INCOME
  EXPENSE
  OTHER_EXPENSE
}

enum JournalType {
  SALES
  PURCHASE
  BANK
  CASH
}

enum EntryStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum BudgetStatus {
  DRAFT
  CONFIRMED
  REVISED
  CANCELLED
}

enum BudgetType {
  INCOME
  EXPENSE
}

enum PaymentType {
  RECEIVE
  SEND
}

enum PaymentMethod {
  BANK
  CASH
  ONLINE
}

enum PaymentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum GatewayStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SourceType {
  CUSTOMER_INVOICE
  VENDOR_BILL
  CUSTOMER_PAYMENT
  VENDOR_PAYMENT
  MANUAL
}

// ------------------------------------------------------
// AUTH & RBAC (5 Tables)
// ------------------------------------------------------
model User {
  id               String          @id @default(uuid())
  name             String
  loginId          String          @unique // 6-12 chars
  email            String          @unique
  passwordHash     String
  roleId           String
  role             Role            @relation(fields: [roleId], references: [id])
  isActive         Boolean         @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  customerMappings CustomerUser[]
  auditLogs        AuditLog[]
  createdSO        SalesOrder[]    @relation("CreatedByUser")
  createdINV       CustomerInvoice[] @relation("CreatedByUser")
  createdPO        PurchaseOrder[] @relation("CreatedByUser")
  createdBILL      VendorBill[]    @relation("CreatedByUser")
  createdPAY       Payment[]       @relation("CreatedByUser")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // USER, ACCOUNTANT, ADMIN
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id        String           @id @default(uuid())
  code      String           @unique // e.g., user.create, invoice.confirm
  name      String
  module    String           // Auth, Sales, Purchase, Accounting, etc.
  roles     RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ------------------------------------------------------
// CONTACT & MASTER DATA (5 Tables)
// ------------------------------------------------------
model Contact {
  id           String               @id @default(uuid())
  name         String
  type         ContactType
  imageUrl     String?
  phone        String?
  email        String?
  street       String?
  city         String?
  state        String?
  country      String?
  pincode      String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  bankAccounts ContactBankAccount[]
  userLinks    CustomerUser[]
  soList       SalesOrder[]
  invoices     CustomerInvoice[]
  poList       PurchaseOrder[]
  bills        VendorBill[]
  payments     Payment[]
  journalEntries JournalEntry[]
  journalItems   JournalItem[]
  budgets      Budget[]             @relation("ResponsibleContact")
}

model ContactBankAccount {
  id                String   @id @default(uuid())
  contactId         String
  contact           Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  bankName          String
  accountHolderName String
  accountNumber     String
  ifscCode          String?
  branch            String?
  isDefault         Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ProductCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id           String                @id @default(uuid())
  name         String
  categoryId   String
  category     ProductCategory       @relation(fields: [categoryId], references: [id])
  productType  ProductType           @default(GOODS)
  salesPrice   Float
  cost         Float
  imageUrl     String?
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  soLines      SalesOrderLine[]
  invLines     CustomerInvoiceLine[]
  poLines      PurchaseOrderLine[]
  billLines    VendorBillLine[]
}

model AnalyticAccount {
  id           String                @id @default(uuid())
  name         String
  type         BudgetType            @default(EXPENSE)
  startDate    DateTime?
  endDate      DateTime?
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  budgets      Budget[]
  soLines      SalesOrderLine[]
  invLines     CustomerInvoiceLine[]
  poLines      PurchaseOrderLine[]
  billLines    VendorBillLine[]
  journalItems JournalItem[]
}

// ------------------------------------------------------
// PORTAL ACCESS (1 Table)
// ------------------------------------------------------
model CustomerUser {
  userId     String
  customerId String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer   Contact @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([userId, customerId])
}

// ------------------------------------------------------
// BUDGETS (1 Table)
// ------------------------------------------------------
model Budget {
  id                   String          @id @default(uuid())
  name                 String
  analyticAccountId    String
  analyticAccount      AnalyticAccount @relation(fields: [analyticAccountId], references: [id])
  type                 BudgetType      @default(EXPENSE)
  startDate            DateTime
  endDate              DateTime
  committedAmount      Float
  responsibleContactId String
  responsibleContact   Contact         @relation("ResponsibleContact", fields: [responsibleContactId], references: [id])
  status               BudgetStatus    @default(DRAFT)
  revisionOfId         String?
  revisionOf           Budget?         @relation("BudgetRevision", fields: [revisionOfId], references: [id])
  revisedBudgets       Budget[]        @relation("BudgetRevision")
  isArchived           Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

// ------------------------------------------------------
// SALES (4 Tables)
// ------------------------------------------------------
model SalesOrder {
  id         String           @id @default(uuid())
  number     String           @unique // e.g. SO/2026/0001
  customerId String
  customer   Contact          @relation(fields: [customerId], references: [id])
  orderDate  DateTime
  status     EntryStatus      @default(DRAFT)
  createdBy  String
  creator    User             @relation("CreatedByUser", fields: [createdBy], references: [id])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  lines      SalesOrderLine[]
  invoices   CustomerInvoice[]
}

model SalesOrderLine {
  id                String           @id @default(uuid())
  salesOrderId      String
  salesOrder        SalesOrder       @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product          @relation(fields: [productId], references: [id])
  analyticAccountId String?
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id])
  quantity          Float
  unitPrice         Float
  total             Float
}

model CustomerInvoice {
  id               String                @id @default(uuid())
  number           String                @unique // e.g. INV/2026/0001
  salesOrderId     String?
  salesOrder       SalesOrder?           @relation(fields: [salesOrderId], references: [id])
  customerId       String
  customer         Contact               @relation(fields: [customerId], references: [id])
  invoiceReference String?
  invoiceDate      DateTime
  dueDate          DateTime
  status           InvoiceStatus         @default(DRAFT)
  createdBy        String
  creator          User                  @relation("CreatedByUser", fields: [createdBy], references: [id])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  lines            CustomerInvoiceLine[]
  allocations      PaymentAllocation[]
}

model CustomerInvoiceLine {
  id                String           @id @default(uuid())
  invoiceId         String
  invoice           CustomerInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId         String
  product           Product          @relation(fields: [productId], references: [id])
  accountId         String
  account           ChartOfAccount   @relation(fields: [accountId], references: [id])
  analyticAccountId String?
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id])
  quantity          Float
  unitPrice         Float
  total             Float
}

// ------------------------------------------------------
// PURCHASE (4 Tables)
// ------------------------------------------------------
model PurchaseOrder {
  id         String              @id @default(uuid())
  number     String              @unique // e.g. PO/2026/0001
  vendorId   String
  vendor     Contact             @relation(fields: [vendorId], references: [id])
  orderDate  DateTime
  status     EntryStatus         @default(DRAFT)
  createdBy  String
  creator    User                @relation("CreatedByUser", fields: [createdBy], references: [id])
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  lines      PurchaseOrderLine[]
  bills      VendorBill[]
}

model PurchaseOrderLine {
  id                String           @id @default(uuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product          @relation(fields: [productId], references: [id])
  analyticAccountId String?
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id])
  quantity          Float
  unitPrice         Float
  total             Float
}

model VendorBill {
  id              String            @id @default(uuid())
  number          String            @unique // e.g. BILL/2026/0001
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  vendorId        String
  vendor          Contact           @relation(fields: [vendorId], references: [id])
  billReference   String?
  billDate        DateTime
  dueDate         DateTime
  status          InvoiceStatus     @default(DRAFT)
  createdBy       String
  creator         User              @relation("CreatedByUser", fields: [createdBy], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lines           VendorBillLine[]
  allocations     PaymentAllocation[]
}

model VendorBillLine {
  id                String           @id @default(uuid())
  vendorBillId      String
  vendorBill        VendorBill       @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  productId         String
  product           Product          @relation(fields: [productId], references: [id])
  accountId         String
  account           ChartOfAccount   @relation(fields: [accountId], references: [id])
  analyticAccountId String?
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id])
  quantity          Float
  unitPrice         Float
  total             Float
}

// ------------------------------------------------------
// PAYMENTS (3 Tables)
// ------------------------------------------------------
model Payment {
  id            String              @id @default(uuid())
  number        String              @unique // e.g. PAY/2026/0001
  paymentType   PaymentType
  partnerType   ContactType
  partnerId     String
  partner       Contact             @relation(fields: [partnerId], references: [id])
  amount        Float
  paymentDate   DateTime
  paymentMethod PaymentMethod       @default(BANK)
  status        PaymentStatus       @default(DRAFT)
  reference     String?
  note          String?
  createdBy     String
  creator       User                @relation("CreatedByUser", fields: [createdBy], references: [id])
  createdAt     DateTime            @default(now())
  confirmedAt   DateTime?
  allocations   PaymentAllocation[]
  gatewayTxns   PaymentGatewayTransaction[]
}

model PaymentAllocation {
  id                String           @id @default(uuid())
  paymentId         String
  payment           Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  documentType      SourceType       // CUSTOMER_INVOICE or VENDOR_BILL
  customerInvoiceId String?
  customerInvoice   CustomerInvoice? @relation(fields: [customerInvoiceId], references: [id])
  vendorBillId      String?
  vendorBill        VendorBill?      @relation(fields: [vendorBillId], references: [id])
  allocatedAmount   Float
  createdAt         DateTime         @default(now())
}

model PaymentGatewayTransaction {
  id                    String        @id @default(uuid())
  paymentId             String
  payment               Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  provider              String        // RAZORPAY
  providerOrderId       String
  providerTransactionId String?
  amount                Float
  currency              String        @default("INR")
  status                GatewayStatus @default(PENDING)
  failureReason         String?
  initiatedAt           DateTime      @default(now())
  completedAt           DateTime?
  createdAt             DateTime      @default(now())
}

// ------------------------------------------------------
// ACCOUNTING CORE (4 Tables)
// ------------------------------------------------------
model ChartOfAccount {
  id           String               @id @default(uuid())
  code         String               @unique
  name         String
  type         AccountType
  parentId     String?
  parent       ChartOfAccount?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     ChartOfAccount[]     @relation("AccountHierarchy")
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  journals     Journal[]            @relation("DefaultAccount")
  invLines     CustomerInvoiceLine[]
  billLines    VendorBillLine[]
  journalItems JournalItem[]
}

model Journal {
  id               String         @id @default(uuid())
  name             String
  type             JournalType
  defaultAccountId String
  defaultAccount   ChartOfAccount @relation("DefaultAccount", fields: [defaultAccountId], references: [id])
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  entries          JournalEntry[]
}

model JournalEntry {
  id             String        @id @default(uuid())
  number         String        @unique // e.g. MISC/2026/0001
  journalId      String
  journal        Journal       @relation(fields: [journalId], references: [id])
  partnerId      String?
  partner        Contact?      @relation(fields: [partnerId], references: [id])
  accountingDate DateTime
  documentDate   DateTime
  status         EntryStatus   @default(DRAFT)
  sourceType     SourceType    @default(MANUAL)
  sourceId       String?
  total          Float
  createdAt      DateTime      @default(now())
  postedAt       DateTime?
  cancelledAt    DateTime?
  items          JournalItem[]
}

model JournalItem {
  id                String           @id @default(uuid())
  entryId           String
  entry             JournalEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId         String
  account           ChartOfAccount   @relation(fields: [accountId], references: [id])
  partnerId         String?
  partner           Contact?         @relation(fields: [partnerId], references: [id])
  analyticAccountId String?
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id])
  debit             Float            @default(0.0)
  credit            Float            @default(0.0)
  description       String?
}

// ------------------------------------------------------
// SECURITY & AUDIT (1 Table)
// ------------------------------------------------------
model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  entityType String   // VendorBill, Invoice, JournalEntry, User, etc.
  entityId   String
  action     String   // CREATE, UPDATE, CONFIRM, POST, CANCEL, DEACTIVATE
  oldValues  Json?
  newValues  Json?
  createdAt  DateTime @default(now())
}
