# Urban Furniture Accounting System
# Monorepo: Next.js frontend at the root, Express + Prisma backend in backend/.
# Patterns without a leading slash apply at every level, so they cover both apps.

# ---------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Lockfiles are intentionally committed (package-lock.json in / and backend/).

# ---------------------------------------------------------------
# Build output
# ---------------------------------------------------------------
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------
# Covers .env, .env.local, backend/.env and friends. Never commit real
# credentials - JWT_SECRET, DATABASE_URL and gateway keys live in these.
.env
.env.*
!.env.example

# ---------------------------------------------------------------
# Prisma
# ---------------------------------------------------------------
# The generated client lives in node_modules/.prisma (already ignored).
# backend/prisma/schema.prisma and its migrations ARE committed.
prisma/*.db
prisma/*.db-journal

# ---------------------------------------------------------------
# Logs and debug output
# ---------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

# ---------------------------------------------------------------
# Testing
# ---------------------------------------------------------------
coverage/
.nyc_output/

# ---------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.pem

# ---------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------
.vercel
.claude/settings.local.json
scratch/
