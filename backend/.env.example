# ---------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------
# Local development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urban_furniture?schema=public"
#
# Hosted Postgres (Render / Neon / Supabase) requires TLS - append sslmode:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&sslmode=require"
#
# On Render, use the *Internal* Database URL when the API runs in the same
# region (faster, no egress). Use the External URL only from your machine.

PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# Public URL of the frontend. Used for CORS and for building password-reset
# links, so it must be the real deployed URL in production.
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------
# `npm run seed` is idempotent and seeds only what the system needs to run:
# permissions, roles, sign-in accounts, chart of accounts and journals.
# Set this to true to ALSO generate demo contacts, products, invoices and
# payments. Never enable it on a production database.
SEED_DEMO_DATA=false

# Override the initial account credentials in any real deployment.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ACCOUNTANT_EMAIL=
SEED_ACCOUNTANT_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# ---------------------------------------------------------------
# Razorpay (online customer payments)
# ---------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------
# Email (SMTP)
# ---------------------------------------------------------------
# Used for the password reset email. The reset link is built from FRONTEND_URL,
# so make sure that points at the running frontend.
# Without SMTP_HOST the API still answers normally but logs a warning instead of
# sending, so password reset silently does nothing for the user.
APP_NAME=Urban Furniture Accounting
SMTP_HOST=
SMTP_PORT=587
# Leave blank to infer: implicit TLS on port 465, STARTTLS otherwise.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Envelope sender, e.g. "Urban Furniture <no-reply@example.com>". Falls back to SMTP_USER.
SMTP_FROM=

# Example - Gmail with an app password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your_16_char_app_password
#   SMTP_FROM=Urban Furniture <you@gmail.com>
