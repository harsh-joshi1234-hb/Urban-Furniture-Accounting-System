# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION URLS (PostgreSQL)
# ------------------------------------------------------------------------------

# [OPTION A: LOCALHOST POSTGRESQL]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urban_furniture?schema=public"

# [OPTION B: RENDER HOSTED INTERNAL URL] (Used on Render - private network, no SSL required)
# DATABASE_URL="postgresql://USER:PASSWORD@dpg-xxxxxx-a:5432/DB?schema=public"

# [OPTION C: RENDER HOSTED EXTERNAL / REMOTE URL] (Used for local migration with SSL)
# DATABASE_URL="postgresql://USER:PASSWORD@dpg-xxxxxx-a.oregon-postgres.render.com/DB?schema=public&sslmode=require"

# [OPTION D: ASYNC / CONNECTION POOLED URL] (Connection limits and timeouts for scale)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&sslmode=require&connection_limit=10&pool_timeout=20"

# ------------------------------------------------------------------------------
# 2. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 4. FRONTEND ORIGINS (CORS)
# Comma-separated list of allowed origins (e.g. localhost and deployed Vercel URL)
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000,https://urban-furniture-accounting.vercel.app

# ------------------------------------------------------------------------------
# 5. INITIAL DATABASE SEEDING
# ------------------------------------------------------------------------------
SEED_DEMO_DATA=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ACCOUNTANT_EMAIL=
SEED_ACCOUNTANT_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# ------------------------------------------------------------------------------
# 6. RAZORPAY PAYMENT GATEWAY (Optional)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 7. SMTP EMAIL CONFIGURATION (Optional)
# ------------------------------------------------------------------------------
APP_NAME="Urban Furniture Accounting"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
