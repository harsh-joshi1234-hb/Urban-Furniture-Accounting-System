DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urban_accounting?schema=public"
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://localhost:3000

# Razorpay (Placeholder for future implementation)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (SMTP)
# Used for the password reset email. The reset link is built from FRONTEND_URL,
# so make sure that points at the running frontend.
# Without SMTP_HOST the API still answers normally but logs a warning instead of
# sending, so password reset silently does nothing for the user.
APP_NAME=Urban Furniture Accounting
SMTP_HOST=
SMTP_PORT=587
# Leave blank to infer: implicit TLS on port 465, STARTTLS otherwise.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Envelope sender, e.g. "Urban Furniture <no-reply@example.com>". Falls back to SMTP_USER.
SMTP_FROM=

# Example - Gmail with an app password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your_16_char_app_password
#   SMTP_FROM=Urban Furniture <you@gmail.com>
